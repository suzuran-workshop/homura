{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Suzuran Cloud MCP Tools",
  "description": "平台通过 MCP Server 暴露的所有数据访问工具。应用通过 POST /mcp 调用，每次调用需携带 OAuth access token。",
  "version": "1.2.0",
  "transport": {
    "endpoint": "POST /mcp",
    "protocol": "JSON-RPC 2.0",
    "auth": "Authorization: Bearer <access_token>",
    "content_type": "application/json"
  },
  "calling_convention": {
    "request_example": {
      "jsonrpc": "2.0",
      "id": 1,
      "method": "tools/call",
      "params": {
        "name": "org.get",
        "arguments": { "orgId": 1 }
      }
    },
    "response_example": {
      "jsonrpc": "2.0",
      "id": 1,
      "result": {
        "content": [{ "type": "text", "text": "{\"id\":1,\"name\":\"演示服务商\"}" }]
      }
    }
  },
  "scopes": [
    "org.read", "org.write",
    "file.read", "file.write",
    "audit.read", "audit.write",
    "workflow.read", "workflow.write",
    "data.read", "data.write",
    "data.read", "data.write"
  ],
  "tools": [
    {
      "name": "org.get",
      "description": "获取组织详情",
      "required_scope": "org.read",
      "input": {
        "type": "object",
        "properties": {
          "orgId": { "type": "integer", "description": "组织 ID" }
        },
        "required": ["orgId"]
      }
    },
    {
      "name": "org.list",
      "description": "列出所有组织（仅 provider 角色）",
      "required_scope": "org.read",
      "required_role": "provider",
      "input": { "type": "object", "properties": {} }
    },
    {
      "name": "org.create",
      "description": "创建组织（仅 provider 角色）",
      "required_scope": "org.write",
      "required_role": "provider",
      "input": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "description": { "type": "string" }
        },
        "required": ["name"]
      }
    },
    {
      "name": "org.update",
      "description": "更新组织信息（仅 provider 角色）",
      "required_scope": "org.write",
      "required_role": "provider",
      "input": {
        "type": "object",
        "properties": {
          "orgId": { "type": "integer" },
          "name": { "type": "string" },
          "description": { "type": "string" }
        },
        "required": ["orgId"]
      }
    },
    {
      "name": "org.delete",
      "description": "删除组织（仅 provider 角色）",
      "required_scope": "org.write",
      "required_role": "provider",
      "input": {
        "type": "object",
        "properties": { "orgId": { "type": "integer" } },
        "required": ["orgId"]
      }
    },
    {
      "name": "user.list_members",
      "description": "列出组织内所有成员",
      "required_scope": "org.read",
      "input": {
        "type": "object",
        "properties": { "orgId": { "type": "integer" } },
        "required": ["orgId"]
      }
    },
    {
      "name": "user.create_member",
      "description": "创建组织成员",
      "required_scope": "org.write",
      "input": {
        "type": "object",
        "properties": {
          "orgId": { "type": "integer" },
          "phone": { "type": "string" },
          "name": { "type": "string" },
          "email": { "type": "string" },
          "position": { "type": "string" },
          "isAdmin": { "type": "boolean", "default": false },
          "departmentId": { "type": "integer" },
          "isDepartmentManager": { "type": "boolean", "default": false }
        },
        "required": ["orgId", "phone", "name"]
      }
    },
    {
      "name": "user.update_member",
      "description": "更新成员信息",
      "required_scope": "org.write",
      "input": {
        "type": "object",
        "properties": {
          "orgId": { "type": "integer" },
          "userId": { "type": "integer" },
          "name": { "type": "string" },
          "email": { "type": "string" },
          "position": { "type": "string" },
          "isAdmin": { "type": "boolean" },
          "departmentId": { "type": "integer" },
          "isDepartmentManager": { "type": "boolean" }
        },
        "required": ["orgId", "userId"]
      }
    },
    {
      "name": "user.remove_member",
      "description": "从组织移除成员",
      "required_scope": "org.write",
      "input": {
        "type": "object",
        "properties": {
          "orgId": { "type": "integer" },
          "userId": { "type": "integer" }
        },
        "required": ["orgId", "userId"]
      }
    },
    {
      "name": "dept.list",
      "description": "列出组织内所有部门",
      "required_scope": "org.read",
      "input": {
        "type": "object",
        "properties": { "orgId": { "type": "integer" } },
        "required": ["orgId"]
      }
    },
    {
      "name": "dept.get",
      "description": "获取部门详情",
      "required_scope": "org.read",
      "input": {
        "type": "object",
        "properties": { "deptId": { "type": "integer" } },
        "required": ["deptId"]
      }
    },
    {
      "name": "dept.tree",
      "description": "获取组织部门树结构",
      "required_scope": "org.read",
      "input": {
        "type": "object",
        "properties": { "orgId": { "type": "integer" } },
        "required": ["orgId"]
      }
    },
    {
      "name": "dept.create",
      "description": "创建部门",
      "required_scope": "org.write",
      "input": {
        "type": "object",
        "properties": {
          "orgId": { "type": "integer" },
          "name": { "type": "string" },
          "parentId": { "type": "integer" },
          "level": { "type": "integer", "default": 1 },
          "description": { "type": "string" }
        },
        "required": ["orgId", "name"]
      }
    },
    {
      "name": "dept.update",
      "description": "更新部门信息",
      "required_scope": "org.write",
      "input": {
        "type": "object",
        "properties": {
          "deptId": { "type": "integer" },
          "name": { "type": "string" },
          "parentId": { "type": "integer" },
          "level": { "type": "integer" },
          "description": { "type": "string" }
        },
        "required": ["deptId"]
      }
    },
    {
      "name": "dept.delete",
      "description": "删除部门",
      "required_scope": "org.write",
      "input": {
        "type": "object",
        "properties": { "deptId": { "type": "integer" } },
        "required": ["deptId"]
      }
    },
    {
      "name": "dept.set_manager",
      "description": "设置部门经理",
      "required_scope": "org.write",
      "input": {
        "type": "object",
        "properties": {
          "deptId": { "type": "integer" },
          "managerUserId": { "type": "integer" }
        },
        "required": ["deptId", "managerUserId"]
      }
    },
    {
      "name": "file.upload",
      "description": "上传文件到对象存储",
      "required_scope": "file.write",
      "input": {
        "type": "object",
        "properties": {
          "orgId": { "type": "integer" },
          "fileName": { "type": "string" },
          "fileBase64": { "type": "string", "description": "文件内容 base64 编码" },
          "contentType": { "type": "string" }
        },
        "required": ["orgId", "fileName", "fileBase64", "contentType"]
      }
    },
    {
      "name": "file.download",
      "description": "获取文件下载的预签名 URL",
      "required_scope": "file.read",
      "input": {
        "type": "object",
        "properties": {
          "objectKey": { "type": "string" },
          "expiryMinutes": { "type": "integer", "default": 60 }
        },
        "required": ["objectKey"]
      }
    },
    {
      "name": "file.delete",
      "description": "删除文件",
      "required_scope": "file.write",
      "input": {
        "type": "object",
        "properties": { "objectKey": { "type": "string" } },
        "required": ["objectKey"]
      }
    },
    {
      "name": "file.list",
      "description": "列出组织文件",
      "required_scope": "file.read",
      "input": {
        "type": "object",
        "properties": {
          "orgId": { "type": "integer" },
          "prefix": { "type": "string" },
          "limit": { "type": "integer", "default": 100 }
        },
        "required": ["orgId"]
      }
    },
    {
      "name": "file.presigned_url",
      "description": "生成文件预签名访问 URL",
      "required_scope": "file.read",
      "input": {
        "type": "object",
        "properties": {
          "objectKey": { "type": "string" },
          "expiryMinutes": { "type": "integer", "default": 60 }
        },
        "required": ["objectKey"]
      }
    },
    {
      "name": "audit.query",
      "description": "查询审计日志",
      "required_scope": "audit.read",
      "input": {
        "type": "object",
        "properties": {
          "orgId": { "type": "integer" },
          "userId": { "type": "integer" },
          "action": { "type": "string" },
          "resourceType": { "type": "string" },
          "startTime": { "type": "string", "format": "date-time" },
          "endTime": { "type": "string", "format": "date-time" },
          "limit": { "type": "integer", "default": 100 },
          "offset": { "type": "integer", "default": 0 }
        }
      }
    },
    {
      "name": "audit.log",
      "description": "记录自定义审计日志条目",
      "required_scope": "audit.write",
      "input": {
        "type": "object",
        "properties": {
          "orgId": { "type": "integer" },
          "action": { "type": "string" },
          "resourceType": { "type": "string" },
          "resourceId": { "type": "integer" },
          "metadata": { "type": "object" }
        },
        "required": ["orgId", "action", "resourceType"]
      }
    },
    {
      "name": "workflow.define",
      "description": "创建流程定义（步骤、变量、指派）。definition 是 JSON 对象：{name, variables, steps[]}，每个 step 类型为 start/approval/condition/end",
      "required_scope": "workflow.write",
      "input": {
        "type": "object",
        "properties": {
          "orgId": { "type": "integer", "description": "组织 ID" },
          "name": { "type": "string", "description": "流程名称" },
          "description": { "type": "string", "description": "流程描述（可选）" },
          "definition": { "type": "object", "description": "流程定义 JSON" }
        },
        "required": ["orgId", "name", "definition"]
      }
    },
    {
      "name": "workflow.get_definition",
      "description": "获取流程定义详情（含完整步骤图）",
      "required_scope": "workflow.read",
      "input": {
        "type": "object",
        "properties": {
          "orgId": { "type": "integer" },
          "definitionId": { "type": "integer" }
        },
        "required": ["orgId", "definitionId"]
      }
    },
    {
      "name": "workflow.list_definitions",
      "description": "列出组织内所有流程定义",
      "required_scope": "workflow.read",
      "input": {
        "type": "object",
        "properties": {
          "orgId": { "type": "integer" }
        },
        "required": ["orgId"]
      }
    },
    {
      "name": "workflow.archive",
      "description": "归档流程定义（归档后不可再启动新实例）",
      "required_scope": "workflow.write",
      "input": {
        "type": "object",
        "properties": {
          "orgId": { "type": "integer" },
          "definitionId": { "type": "integer" }
        },
        "required": ["orgId", "definitionId"]
      }
    },
    {
      "name": "workflow.start",
      "description": "从定义启动流程实例，传入初始变量",
      "required_scope": "workflow.write",
      "input": {
        "type": "object",
        "properties": {
          "orgId": { "type": "integer" },
          "definitionId": { "type": "integer" },
          "variables": { "type": "object", "description": "初始流程变量，如 {leaveDays:3, leaveType:'sick'}" }
        },
        "required": ["orgId", "definitionId"]
      }
    },
    {
      "name": "workflow.get_instance",
      "description": "获取流程实例详情（含当前步骤、状态、变量、完整任务历史）",
      "required_scope": "workflow.read",
      "input": {
        "type": "object",
        "properties": {
          "orgId": { "type": "integer" },
          "instanceId": { "type": "integer" }
        },
        "required": ["orgId", "instanceId"]
      }
    },
    {
      "name": "workflow.list_instances",
      "description": "列出组织内流程实例，可按状态过滤（running/approved/rejected/cancelled）",
      "required_scope": "workflow.read",
      "input": {
        "type": "object",
        "properties": {
          "orgId": { "type": "integer" },
          "status": { "type": "string", "description": "可选状态过滤" }
        },
        "required": ["orgId"]
      }
    },
    {
      "name": "workflow.cancel",
      "description": "取消运行中的流程实例（仅发起人或 org_admin 可执行）",
      "required_scope": "workflow.write",
      "input": {
        "type": "object",
        "properties": {
          "orgId": { "type": "integer" },
          "instanceId": { "type": "integer" }
        },
        "required": ["orgId", "instanceId"]
      }
    },
    {
      "name": "workflow.list_tasks",
      "description": "列出调用者的流程任务（待办与已办），可按状态过滤（pending/approved/rejected）",
      "required_scope": "workflow.read",
      "input": {
        "type": "object",
        "properties": {
          "status": { "type": "string", "description": "可选状态过滤" }
        }
      }
    },
    {
      "name": "workflow.approve",
      "description": "审批通过分配给调用者的待办任务，使实例沿 approve 分支推进",
      "required_scope": "workflow.write",
      "input": {
        "type": "object",
        "properties": {
          "orgId": { "type": "integer" },
          "taskId": { "type": "integer" },
          "comment": { "type": "string", "description": "审批意见（可选）" }
        },
        "required": ["orgId", "taskId"]
      }
    },
    {
      "name": "workflow.reject",
      "description": "拒绝分配给调用者的待办任务，使实例沿 reject 分支推进",
      "required_scope": "workflow.write",
      "input": {
        "type": "object",
        "properties": {
          "orgId": { "type": "integer" },
          "taskId": { "type": "integer" },
          "comment": { "type": "string", "description": "拒绝意见（可选）" }
        },
        "required": ["orgId", "taskId"]
      }
    },
    {
      "name": "data.create_table",
      "description": "为应用创建业务数据表。表名自动添加应用 ID 前缀实现隔离，自动添加 id/org_id/created_at/updated_at 列",
      "required_scope": "data.write",
      "input": {
        "type": "object",
        "properties": {
          "orgId": { "type": "integer", "description": "组织 ID" },
          "tableName": { "type": "string", "description": "表名（小写字母、数字、下划线，最长 63 字符）" },
          "columns": {
            "type": "array",
            "description": "列定义数组",
            "items": {
              "type": "object",
              "properties": {
                "name": { "type": "string", "description": "列名" },
                "type": { "type": "string", "enum": ["text", "integer", "boolean", "timestamp", "jsonb", "numeric", "date"], "description": "列类型" },
                "nullable": { "type": "boolean", "description": "是否允许 NULL（默认 true）" },
                "primaryKey": { "type": "boolean", "description": "是否为主键" },
                "defaultValue": { "description": "默认值" }
              },
              "required": ["name", "type"]
            }
          }
        },
        "required": ["orgId", "tableName", "columns"]
      }
    },
    {
      "name": "data.drop_table",
      "description": "删除应用拥有的业务数据表",
      "required_scope": "data.write",
      "input": {
        "type": "object",
        "properties": {
          "orgId": { "type": "integer", "description": "组织 ID" },
          "tableName": { "type": "string", "description": "表名" }
        },
        "required": ["orgId", "tableName"]
      }
    },
    {
      "name": "data.list_tables",
      "description": "列出应用拥有的所有业务数据表",
      "required_scope": "data.read",
      "input": {
        "type": "object",
        "properties": {
          "orgId": { "type": "integer", "description": "组织 ID" }
        },
        "required": ["orgId"]
      }
    },
    {
      "name": "data.describe_table",
      "description": "获取表的列定义信息",
      "required_scope": "data.read",
      "input": {
        "type": "object",
        "properties": {
          "orgId": { "type": "integer", "description": "组织 ID" },
          "tableName": { "type": "string", "description": "表名" }
        },
        "required": ["orgId", "tableName"]
      }
    },
    {
      "name": "data.insert",
      "description": "向表中插入一行数据",
      "required_scope": "data.write",
      "input": {
        "type": "object",
        "properties": {
          "orgId": { "type": "integer", "description": "组织 ID" },
          "tableName": { "type": "string", "description": "表名" },
          "data": { "type": "object", "description": "要插入的数据（键值对）" }
        },
        "required": ["orgId", "tableName", "data"]
      }
    },
    {
      "name": "data.batch_insert",
      "description": "批量插入多行数据",
      "required_scope": "data.write",
      "input": {
        "type": "object",
        "properties": {
          "orgId": { "type": "integer", "description": "组织 ID" },
          "tableName": { "type": "string", "description": "表名" },
          "rows": {
            "type": "array",
            "description": "数据行数组",
            "items": { "type": "object" }
          }
        },
        "required": ["orgId", "tableName", "rows"]
      }
    },
    {
      "name": "data.query",
      "description": "查询表中的数据，支持过滤、排序、分页",
      "required_scope": "data.read",
      "input": {
        "type": "object",
        "properties": {
          "orgId": { "type": "integer", "description": "组织 ID" },
          "tableName": { "type": "string", "description": "表名" },
          "where": { "type": "object", "description": "过滤条件（键值对，所有条件用 AND 组合）" },
          "orderBy": { "type": "string", "description": "排序列名" },
          "limit": { "type": "integer", "description": "最大返回行数（默认 100）" },
          "offset": { "type": "integer", "description": "跳过行数（默认 0）" }
        },
        "required": ["orgId", "tableName"]
      }
    },
    {
      "name": "data.update",
      "description": "更新表中符合条件的的行",
      "required_scope": "data.write",
      "input": {
        "type": "object",
        "properties": {
          "orgId": { "type": "integer", "description": "组织 ID" },
          "tableName": { "type": "string", "description": "表名" },
          "where": { "type": "object", "description": "过滤条件" },
          "data": { "type": "object", "description": "要更新的数据" }
        },
        "required": ["orgId", "tableName", "where", "data"]
      }
    },
    {
      "name": "data.delete",
      "description": "删除表中符合条件的行",
      "required_scope": "data.write",
      "input": {
        "type": "object",
        "properties": {
          "orgId": { "type": "integer", "description": "组织 ID" },
          "tableName": { "type": "string", "description": "表名" },
          "where": { "type": "object", "description": "过滤条件" }
        },
        "required": ["orgId", "tableName", "where"]
      }
    },
    {
      "name": "data.count",
      "description": "统计符合条件的行数",
      "required_scope": "data.read",
      "input": {
        "type": "object",
        "properties": {
          "orgId": { "type": "integer", "description": "组织 ID" },
          "tableName": { "type": "string", "description": "表名" },
          "where": { "type": "object", "description": "过滤条件" }
        },
        "required": ["orgId", "tableName"]
      }
    },
    {
      "name": "data.add_column",
      "description": "向现有表添加新列",
      "required_scope": "data.write",
      "input": {
        "type": "object",
        "properties": {
          "orgId": { "type": "integer", "description": "组织 ID" },
          "tableName": { "type": "string", "description": "表名" },
          "column": {
            "type": "object",
            "description": "列定义",
            "properties": {
              "name": { "type": "string", "description": "列名" },
              "type": { "type": "string", "description": "列类型" },
              "nullable": { "type": "boolean", "description": "是否允许 NULL" },
              "defaultValue": { "description": "默认值" }
            },
            "required": ["name", "type"]
          }
        },
        "required": ["orgId", "tableName", "column"]
      }
    },
    {
      "name": "data.exec_raw",
      "description": "执行参数化的原始 SQL 查询（仅限应用自己的表）",
      "required_scope": "data.write",
      "input": {
        "type": "object",
        "properties": {
          "orgId": { "type": "integer", "description": "组织 ID" },
          "sql": { "type": "string", "description": "SQL 语句，使用 $1, $2 等占位符" },
          "params": { "type": "array", "description": "占位符参数值数组", "items": {} }
        },
        "required": ["orgId", "sql"]
      }
    }
  ]
}
