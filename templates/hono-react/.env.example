# homura template 环境变量样例
# 由 scripts/gen-env-example.mjs 从 src/server/env.ts 的 configSpecs 自动生成
# ⚠ 勿手改：改 env.ts 后重跑 `pnpm gen:env`
#
# 渐进式：只填你要启用的能力对应的变量，其余留空即不启用该能力

# 由 @homurajs/core defineConfig 生成（配置即文档）

# 监听端口（standalone；qw-pages 由平台注入 PORT）
PORT=3000

# 数据方言：'sqlite'（node:sqlite 本地文件）| 'pg'（自建 pgsql / 自托管 supabase 直连）| 'rest'（PostgREST，qw-pages 唯一可用）。缺省：standalone→sqlite，qw-pages→rest
DIALECT=

# session HS256 密钥（>=32B，生产必须改）
SESSION_SECRET=<redacted>

# pg 直连 URL（dialect=pg 且非 supabase 时）
DATABASE_URL=

# supabase project ref（仅自托管 supabase 的 PG 直连；qw-pages 不下发）
SUPABASE_PROJECT_REF=

# supabase DB 密码（仅自托管；qw-pages 不下发）
SUPABASE_DB_PASSWORD=<redacted>

# supabase region（Supavisor host 拼装）
SUPABASE_REGION=

# supabase 平台 URL（qw-pages 自动注入）
SUPABASE_URL=

# supabase anon key（PostgREST 与 storage 用；qw-pages 自动注入）
SUPABASE_ANON_KEY=<redacted>

# supabase 存储桶名（必须预先存在：qw-pages 上 anon 与迁移角色都无建桶权）
STORAGE_SUPABASE_BUCKET=files

# sqlite 文件路径（:memory: 支持；仅 standalone）
SQLITE_PATH=./data/app.db

# oauth2-dingtalk 组织标识（配置即启用登录）
OAUTH_DINGTALK_ORG_ID=

# oauth2-dingtalk 部署地址（默认线上）
OAUTH_DINGTALK_BASE_URL=

# OAuth2 client id（= 钉钉 AppKey）
OAUTH_CLIENT_ID=

# OAuth2 client secret
OAUTH_CLIENT_SECRET=<redacted>

# 回调地址（如 https://app.example/auth/oauth2/callback）
OAUTH_REDIRECT_URI=

# OAuth2 首次登录是否自动建户（JIT provisioning）；false 则要求预先注册并关联
AUTH_OAUTH2_JIT=true

# 是否启用用户名密码认证（TextPassword）；缺省 false（opt-in，配了才启用）
AUTH_PASSWORD_ENABLED=false

# 是否允许自助注册（false 则只能由管理员创建账户）
AUTH_PASSWORD_ALLOW_SELF_REGISTER=true

# 是否启用 WebAuthn（Passkey）认证
AUTH_WEBAUTHN_ENABLED=false

# WebAuthn RP ID（通常是域名，如 app.example.com）
AUTH_WEBAUTHN_RP_ID=

# WebAuthn RP 显示名称（如 "My App"）
AUTH_WEBAUTHN_RP_NAME=

# WebAuthn 允许的 origin（如 https://app.example.com；多 origin 用逗号分隔）
AUTH_WEBAUTHN_ORIGIN=

# 钉钉企业应用 AppKey（配置即启用 3p）
DINGTALK_APP_KEY=

# 钉钉企业应用 AppSecret
DINGTALK_APP_SECRET=<redacted>

# 钉钉 AgentId（工作通知用）
DINGTALK_AGENT_ID=

# 存储后端：none（不启用）| local | s3 | supabase | db（二进制写进数据库，qw-pages 唯一可用，有大小上限）
STORAGE_BACKEND=none

# local 存储根目录
STORAGE_LOCAL_DIR=./data/files

# db 后端单文件总上限（字节），超限即拒；缺省 50MB。大文件请改用 s3 预签名直传
STORAGE_DB_MAX_BYTES=52428800

# db 后端每块原始字节数；缺省 384KB（base64 入库后 512KB，安全避开 qw-pages 网关与 PostgREST 的 ~1MB 限制）
STORAGE_DB_CHUNK_SIZE=393216

# s3 兼容端点
S3_ENDPOINT=

# s3 region
S3_REGION=us-east-1

# s3 bucket
S3_BUCKET=

# s3 access key
S3_ACCESS_KEY=<redacted>

# s3 secret key
S3_SECRET_KEY=<redacted>

# s3 寻址风格：true=path-style（minio 缺省）；阿里云 OSS 必须 false（virtual-hosted，否则对象操作报 SecondLevelDomainForbidden）
S3_FORCE_PATH_STYLE=true

# homura-genuine 地址（配置即启用激活守卫）
GENUINE_SERVER=

# license productId
GENUINE_PRODUCT_ID=

# license appId
GENUINE_APP_ID=

# license key（可选；中心预签发时用它绑定实例）
GENUINE_LICENSE_KEY=<redacted>

# 中心 Ed25519 公钥 PEM。**配了才验签**，生产必配（否则中心响应可被中间人改成 active）。PEM 是多行，写进 homura.config.env 时用双引号包裹并把换行写成 \n
GENUINE_PUBLIC_KEY=

# enforcement=core 时视为核心功能的路径前缀，逗号分隔（如 '/api,/admin'）；命中即 503，其余放行 + 强提醒
GENUINE_CORE_PATHS=/api

# 前端静态资源目录（默认由 adapter 决定）
HOMURA_ASSETS_DIR=

