{
  "name": "homura",
  "version": "26.10.14",
  "private": true,
  "type": "module",
  "description": "Hono+React 全栈 Node 应用的 template/SDK monorepo，AI 开发，双形态部署（独立 Node 服务 / qw-pages 托管）",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "build": "pnpm -r --filter './packages/*' --workspace-concurrency=1 run build",
    "typecheck": "pnpm -r --no-bail run typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "prettier": "^3.6.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
