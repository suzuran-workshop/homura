{
  "name": "@homura/storage",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "homura 对象存储/图床适配：supabase-storage / s3 兼容(minio/oss) / local-fs 三后端 + 代理路由",
  "exports": {
    ".": "./src/index.ts",
    "./local": "./src/local.ts",
    "./s3": "./src/s3.ts",
    "./supabase": "./src/supabase.ts",
    "./proxy": "./src/proxy.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@homura/core": "workspace:*"
  },
  "peerDependencies": {
    "@aws-sdk/client-s3": "^3.0.0",
    "@aws-sdk/s3-request-presigner": "^3.0.0",
    "@supabase/storage-js": "^2.0.0",
    "hono": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "@aws-sdk/client-s3": { "optional": true },
    "@aws-sdk/s3-request-presigner": { "optional": true },
    "@supabase/storage-js": { "optional": true },
    "hono": { "optional": true }
  }
}
