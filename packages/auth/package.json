{
  "name": "@homurajs/auth",
  "version": "26.10.28",
  "type": "module",
  "description": "homura 认证：标准 OIDC (Authorization Code Flow) 客户端（id_token 验签 + sub 交叉核对）+ 自管 session（HS256 短 JWT + opaque refresh rotate）",
  "engines": {
    "node": ">=22.5"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./hono": "./src/hono/index.ts",
    "./tables": "./src/tables.ts",
    "./webauthn": "./src/webauthn/index.ts"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./hono": {
        "types": "./dist/hono.d.ts",
        "import": "./dist/hono.js"
      },
      "./tables": {
        "types": "./dist/tables.d.ts",
        "import": "./dist/tables.js"
      },
      "./webauthn": {
        "types": "./dist/webauthn.d.ts",
        "import": "./dist/webauthn.js"
      }
    }
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@homurajs/core": "workspace:*",
    "@homurajs/db": "workspace:*",
    "jose": "^6.0.0"
  },
  "peerDependencies": {
    "@simplewebauthn/server": "^11.0.0",
    "drizzle-orm": "1.0.0-rc.4",
    "hono": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "@simplewebauthn/server": { "optional": true },
    "drizzle-orm": { "optional": true },
    "hono": { "optional": true }
  },
  "devDependencies": {
    "tsdown": "^0.23.1"
  }
}
